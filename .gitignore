node_modules/
.pnp
.pnp.js

# ============================================================
# Lock files (use only one package manager per project)
# ============================================================
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================================
# Environment variables & secrets  <-- NEVER commit these
# ============================================================
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.staging.local
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
secrets/
src/secrets/

# ============================================================
# Build output
# ============================================================
dist/
build/
.tmp/
temp/
.cache/
out/

# ============================================================
